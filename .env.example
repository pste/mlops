# Copia in .env e compila. I GGUF vanno in ./models/data.

# Modello di embedding per l'asse A (es. bge-small, nomic-embed-text)
EMBED_GGUF=nomic-embed-text-v1.5.Q4_K_M.gguf

# Modello leggero del tier-0 (es. Qwen2.5-1.5B-Instruct, Llama-3.2-1B-Instruct)
TIER0_GGUF=qwen2.5-1.5b-instruct-q4_k_m.gguf

# --- Tier-1 (vLLM/GPU) ---
# Endpoint che LiteLLM usa per il tier-1. Default: il servizio vllm-tier1 del
# compose. Per un server GPU esterno in LAN, metti l'IP: http://<ip>:8000/v1
TIER1_API_BASE=http://vllm-tier1:8000/v1
TIER1_API_KEY=sk-noop

# Modello servito dal vllm-tier1 in-compose (e token HF per modelli gated)
TIER1_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TOKEN=

# Chiave master di LiteLLM (il router la usa come bearer)
LITELLM_MASTER_KEY=sk-local-dev

# Provider cloud per il tier-2
OPENAI_API_KEY=
