# Config per il server GPU che ospita il tier-1. Copia in .env sul server.

# Modello da servire (id HuggingFace). served-model-name DEVE combaciare con
# il nome che LiteLLM invia (openai/tier-1) → tienilo "tier-1".
MODEL=Qwen/Qwen2.5-7B-Instruct
SERVED_NAME=tier-1
PORT=8000

# Tuning GPU
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1

# Token HF per modelli gated
HUGGING_FACE_HUB_TOKEN=

# Chiave API opzionale: se la imposti, mettila uguale a TIER1_API_KEY nel .env
# del progetto (quello usato da LiteLLM).
VLLM_API_KEY=

# Path host dove cache-are i pesi (default: ~/.cache/huggingface)
HF_CACHE=
